# Dexy — environment configuration
# Copy to .env.local and fill in once Supabase + Stripe are provisioned.
# The app runs without these (using the auth stub + mock data) for the scaffold.

# --- Supabase (auth + database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (subscriptions) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL=

# Base URL for Stripe redirects / transactional email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
